# ============================================================
# AgentHR — environment configuration
# Copy this file to `.env` and fill in the values.
# ============================================================

# --- AWS / Amazon Bedrock -----------------------------------------
AWS_REGION=us-east-1

# Standard AWS credentials (leave blank if using IAM roles or `aws configure`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock Foundation Model ID
# Default: Amazon Nova Pro (flagship multimodal reasoning & tool-use model)
# Alternatives: us.amazon.nova-lite-v1:0, us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# bedrock -> live Amazon Bedrock API; mock -> deterministic offline fallback
LLM_BACKEND=bedrock

# --- Data store ---------------------------------------------------
# dynamodb -> Amazon DynamoDB (AWS cloud or local endpoint)
# memory   -> in-process store (offline demo, no AWS needed)
STORE_BACKEND=memory

# DynamoDB table prefix
DYNAMODB_TABLE_PREFIX=agenthr_

# Optional local DynamoDB endpoint (e.g. http://localhost:8000)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# --- Application --------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080

# Admin tab credentials (seeded on first boot)
ADMIN_EMAIL=hr@agenthr.ai
ADMIN_PASSWORD=admin123
SECRET_KEY=change-me-in-production

# 1 -> full autonomous pipeline via Strands Agent; 0 -> deterministic-only
AGENT_AUTONOMOUS=1

# 1 -> Pause before schedule_interview & draft_candidate_email for recruiter approval
ENABLE_APPROVAL_GATE=1
